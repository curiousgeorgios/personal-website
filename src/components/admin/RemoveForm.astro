---
interface Props {
  /** The failure form id this reports to, so an unticked remove reopens its entry */
  form: string;
  intent: "item.remove" | "log.remove" | "record.remove" | "link.revoke" | "photo.delete";
  id: number | string;
  /** The checkbox's wording */
  confirm: string;
  section?: string;
  error?: string;
  hint?: string;
  /** The button's word: remove, or revoke for a link */
  button?: string;
}

const { form, intent, id, confirm, section, error, hint, button = "remove" } = Astro.props;
const errorId = `${form}-confirm-error`;
const hintId = `${form}-delete-hint`;
const describedBy = [hint ? hintId : null, error ? errorId : null].filter(Boolean).join(" ") || undefined;
---
<form method="post" action={`/admin/#${form}`} class="admin-form remove">
  <input type="hidden" name="intent" value={intent} />
  <input type="hidden" name="id" value={id} />
  {section && <input type="hidden" name="section" value={section} />}
  <label class="confirm">
    <input type="checkbox" name="confirm" value="yes" required aria-invalid={error ? "true" : undefined} aria-describedby={describedBy} />
    {confirm}
  </label>
  {hint && <p class="hint" id={hintId}>{hint}</p>}
  {error && <p class="error" id={errorId}>{error}</p>}
  <button type="submit" class="button quiet">{button}</button>
</form>
