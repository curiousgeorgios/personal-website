---
interface Props {
  /** The failure form id this reports to, so an unticked remove reopens its entry */
  form: string;
  intent: "item.remove" | "log.remove" | "record.remove";
  id: number;
  /** The checkbox's wording */
  confirm: string;
  section?: string;
  error?: string;
}

const { form, intent, id, confirm, section, error } = Astro.props;
const errorId = `${form}-confirm-error`;
---
<form method="post" action={`/admin/#${form}`} class="admin-form remove">
  <input type="hidden" name="intent" value={intent} />
  <input type="hidden" name="id" value={id} />
  {section && <input type="hidden" name="section" value={section} />}
  <label class="confirm">
    <input type="checkbox" name="confirm" value="yes" required aria-invalid={error ? "true" : undefined} aria-describedby={error ? errorId : undefined} />
    {confirm}
  </label>
  {error && <p class="error" id={errorId}>{error}</p>}
  <button type="submit" class="button quiet">remove</button>
</form>
